# ========================================
# FAST-LIO2 RViz可视化配置文件
# ========================================
# 本文件定义了RViz界面的布局和显示设置
# RViz是ROS2的3D可视化工具，用于实时显示传感器数据、机器人状态等
# 本配置专门用于FAST-LIO2 SLAM系统的数据可视化

# === RViz界面面板配置 ===
# 定义RViz界面左侧和右侧的各种面板布局
Panels:
  # 显示面板 - 管理所有可视化组件（点云、路径、坐标系等）
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays  # 面板名称
    Property Tree Widget:
      Expanded:  # 默认展开的树状选项
        - /Global Options1  # 全局选项
        - /Status1          # 状态信息
      Splitter Ratio: 0.5   # 面板分割比例
    Tree Height: 549        # 树状视图高度
    
  # 选择面板 - 用于选择3D场景中的对象
  - Class: rviz_common/Selection
    Name: Selection
    
  # 工具属性面板 - 显示当前选中工具的参数
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1    # 2D目标姿态工具
      - /Publish Point1   # 发布点工具
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
    
  # 视图面板 - 控制3D场景的观察视角
  - Class: rviz_common/Views
    Expanded:
      - /Current View1    # 当前视图设置
    Name: Views
    Splitter Ratio: 0.5
    
  # 时间面板 - 控制数据的时间同步
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0             # 时间同步模式（0=实时）
    SyncSource: CloudRegistered  # 时间同步的数据源（使用点云数据的时间戳）
# === RViz可视化管理器 ===
# 这是RViz的核心组件，管理所有的显示元素
Visualization Manager:
  Class: ""
  
  # === 显示组件列表 ===
  # 每个显示组件订阅特定的ROS2话题，将数据可视化
  Displays:
  
    # === TF坐标变换显示 ===
    # 功能：显示机器人各部件之间的坐标变换关系
    # ROS2连接：自动订阅 /tf 和 /tf_static 话题
    # 数据来源：LaserMappingNode发布的坐标变换（通过tf_broadcaster_）
    - Class: rviz_default_plugins/TF
      Enabled: true          # 启用TF显示
      Frame Timeout: 15      # 坐标系超时时间（秒）
      Frames:                # 要显示的坐标系
        All Enabled: true    # 显示所有可用坐标系
        body:                # 机器人载体坐标系
          Value: true        # （来源：LaserMappingNode中的"body"坐标系）
        camera_init:         # 世界坐标系/地图坐标系
          Value: true        # （来源：LaserMappingNode中的"camera_init"坐标系）
      Marker Scale: 1        # 坐标轴标记的缩放比例
      Name: TF               # 显示组件名称
      Show Arrows: true      # 显示坐标轴箭头
      Show Axes: true        # 显示坐标轴
      Show Names: false      # 不显示坐标系名称（避免界面混乱）
      Tree:                  # 坐标系层次关系
        camera_init:         # 根坐标系（世界坐标系）
          body:              # 子坐标系（机器人载体坐标系）
            {}               # body坐标系下没有子坐标系
      Update Interval: 0     # 更新间隔（0=尽可能快）
      Value: true            # 启用此显示组件
    # === 里程计显示 ===
    # 功能：显示机器人的位置、姿态和不确定性（协方差椭圆）
    # ROS2连接：订阅 /Odometry 话题
    # 数据来源：LaserMappingNode::publish_odometry()函数发布的里程计数据
    # 数据类型：nav_msgs::msg::Odometry
    - Angle Tolerance: 0.10000000149011612    # 角度容差（弧度）
      Class: rviz_default_plugins/Odometry
      
      # 协方差显示设置（显示位置和姿态的不确定性）
      Covariance:
        Orientation:              # 姿态不确定性可视化
          Alpha: 0.5              # 透明度
          Color: 255; 255; 127    # 颜色（黄色）
          Color Style: Unique     # 颜色样式
          Frame: Local            # 显示坐标系
          Offset: 1               # 偏移量
          Scale: 1                # 缩放比例
          Value: true             # 启用姿态协方差显示
        Position:                 # 位置不确定性可视化
          Alpha: 0.30000001192092896  # 透明度
          Color: 204; 51; 204     # 颜色（紫色）
          Scale: 1                # 缩放比例
          Value: true             # 启用位置协方差显示
        Value: true               # 启用协方差显示
        
      Enabled: true             # 启用里程计显示
      Keep: 100                 # 保留最近100个里程计数据点
      Name: Odometry            # 显示组件名称
      Position Tolerance: 0.10000000149011612  # 位置容差（米）
      
      # 里程计箭头的外观设置
      Shape:
        Alpha: 1                              # 不透明度
        Axes Length: 1                        # 坐标轴长度
        Axes Radius: 0.10000000149011612      # 坐标轴半径
        Color: 255; 25; 0                     # 箭头颜色（红色）
        Head Length: 0.30000001192092896      # 箭头头部长度
        Head Radius: 0.10000000149011612      # 箭头头部半径
        Shaft Length: 1                       # 箭头杆部长度
        Shaft Radius: 0.05000000074505806     # 箭头杆部半径
        Value: Arrow                          # 显示为箭头形状
        
      # ROS2话题订阅设置
      Topic:
        Depth: 5                    # 消息队列深度
        Durability Policy: Volatile # 消息持久性策略
        Filter size: 10             # 滤波器大小
        History Policy: Keep Last   # 历史消息保持策略
        Reliability Policy: Reliable # 可靠性策略
        Value: /Odometry            # 订阅的话题名称（对应publish_odometry函数的输出）
      Value: true                   # 启用此显示组件
    # === 路径轨迹显示 ===
    # 功能：显示机器人的历史运动轨迹
    # ROS2连接：订阅 /path 话题
    # 数据来源：LaserMappingNode::publish_path()函数发布的路径数据
    # 数据类型：nav_msgs::msg::Path
    # 注意：为防止RViz崩溃，publish_path中每10帧才添加一个轨迹点
    - Alpha: 1                                # 路径不透明度
      Buffer Length: 1                        # 缓冲区长度
      Class: rviz_default_plugins/Path
      Color: 25; 255; 0                       # 路径颜色（绿色）
      Enabled: true                           # 启用路径显示
      Head Diameter: 0.30000001192092896      # 箭头头部直径
      Head Length: 0.20000000298023224        # 箭头头部长度
      Length: 0.30000001192092896             # 箭头总长度
      Line Style: Lines                       # 线条样式（直线连接）
      Line Width: 0.029999999329447746        # 线条宽度
      Name: Path                              # 显示组件名称
      
      # 路径偏移设置（通常为0）
      Offset:
        X: 0
        Y: 0
        Z: 0
        
      Pose Color: 255; 85; 255                # 姿态颜色（粉色）
      Pose Style: None                        # 姿态显示样式（不显示）
      Radius: 0.029999999329447746            # 路径点半径
      Shaft Diameter: 0.10000000149011612     # 箭头杆部直径
      Shaft Length: 0.10000000149011612       # 箭头杆部长度
      
      # ROS2话题订阅设置
      Topic:
        Depth: 5                    # 消息队列深度
        Durability Policy: Volatile # 消息持久性策略
        Filter size: 10             # 滤波器大小
        History Policy: Keep Last   # 历史消息保持策略
        Reliability Policy: Reliable # 可靠性策略
        Value: /path                # 订阅的话题名称（对应publish_path函数的输出）
      Value: true                   # 启用此显示组件
    # === 配准后点云显示 ===
    # 功能：显示经过SLAM算法处理后的配准点云
    # ROS2连接：订阅 /cloud_registered 话题
    # 数据来源：LaserMappingNode::publish_frame_world()函数发布的世界系点云
    # 数据类型：sensor_msgs::msg::PointCloud2
    # 说明：这是FAST-LIO2算法的主要输出，显示当前帧LiDAR数据在世界坐标系下的位置
    - Alpha: 1                                # 点云不透明度
      Autocompute Intensity Bounds: true      # 自动计算强度值范围
      
      # 颜色映射的数值范围（基于Z轴高度）
      Autocompute Value Bounds:
        Max Value: 11.062739372253418         # 最大Z值（米）
        Min Value: -13.864188194274902        # 最小Z值（米）
        Value: true                           # 启用自动范围计算
        
      Axis: Z                               # 颜色映射轴（Z轴=高度）
      Channel Name: intensity               # 颜色通道名称
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255                  # 默认颜色（白色）
      Color Transformer: AxisColor          # 颜色变换器（按轴着色）
      Decay Time: 30                        # 点云消失时间（秒）
      Enabled: true                         # 启用点云显示
      Invert Rainbow: false                 # 不反转彩虹色谱
      Max Color: 255; 255; 255              # 最大值颜色（白色）
      Max Intensity: 186                    # 最大强度值
      Min Color: 0; 0; 0                    # 最小值颜色（黑色）
      Min Intensity: 0                      # 最小强度值
      Name: CloudRegistered                 # 显示组件名称
      Position Transformer: XYZ             # 位置变换器
      Selectable: true                      # 点云可选择
      Size (Pixels): 3                      # 点的像素大小
      Size (m): 0.05000000074505806         # 点的物理大小（米）
      Style: Flat Squares                   # 点的显示样式（平面方块）
      
      # ROS2话题订阅设置
      Topic:
        Depth: 5                    # 消息队列深度
        Durability Policy: Volatile # 消息持久性策略
        Filter size: 10             # 滤波器大小
        History Policy: Keep Last   # 历史消息保持策略
        Reliability Policy: Reliable # 可靠性策略
        Value: /cloud_registered    # 订阅的话题名称（对应publish_frame_world函数的输出）
        
      Use Fixed Frame: true         # 使用固定坐标系
      Use rainbow: true             # 使用彩虹色谱（按高度着色）
      Value: true                   # 启用此显示组件
    # === 有效特征点云显示 ===
    # 功能：显示在EKF更新中实际使用的有效特征点
    # ROS2连接：订阅 /cloud_effected 话题
    # 数据来源：LaserMappingNode::publish_effect_world()函数发布的有效点云
    # 数据类型：sensor_msgs::msg::PointCloud2
    # 说明：这些点通过了h_share_model函数中的平面拟合和质量检验，被用于SLAM算法的状态更新
    # 用途：主要用于算法调试，观察哪些点参与了SLAM计算
    - Alpha: 1                                # 点云不透明度
      Autocompute Intensity Bounds: true      # 自动计算强度值范围
      
      # 颜色映射的数值范围
      Autocompute Value Bounds:
        Max Value: 10                         # 最大值
        Min Value: -10                        # 最小值
        Value: true                           # 启用自动范围计算
        
      Axis: Z                               # 颜色映射轴
      Channel Name: intensity               # 颜色通道名称
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255                  # 默认颜色（白色）
      Color Transformer: Intensity          # 颜色变换器（按强度着色）
      Decay Time: 0                         # 点云立即消失（只显示当前帧）
      Enabled: true                         # 启用点云显示
      Invert Rainbow: false                 # 不反转彩虹色谱
      Max Color: 255; 255; 255              # 最大值颜色（白色）
      Max Intensity: 184                    # 最大强度值
      Min Color: 0; 0; 0                    # 最小值颜色（黑色）
      Min Intensity: 0                      # 最小强度值
      Name: CloudEffected                   # 显示组件名称
      Position Transformer: XYZ             # 位置变换器
      Selectable: true                      # 点云可选择
      Size (Pixels): 3                      # 点的像素大小
      Size (m): 0.10000000149011612         # 点的物理大小（比配准点云稍大，便于区分）
      Style: Flat Squares                   # 点的显示样式（平面方块）
      
      # ROS2话题订阅设置
      Topic:
        Depth: 5                    # 消息队列深度
        Durability Policy: Volatile # 消息持久性策略
        Filter size: 10             # 滤波器大小
        History Policy: Keep Last   # 历史消息保持策略
        Reliability Policy: Reliable # 可靠性策略
        Value: /cloud_effected      # 订阅的话题名称（对应publish_effect_world函数的输出）
        
      Use Fixed Frame: true         # 使用固定坐标系
      Use rainbow: true             # 使用彩虹色谱
      Value: true                   # 启用此显示组件
    # === 累积地图点云显示 ===
    # 功能：显示累积的全局地图点云
    # ROS2连接：订阅 /Laser_map 话题
    # 数据来源：LaserMappingNode::publish_map()函数发布的累积地图
    # 数据类型：sensor_msgs::msg::PointCloud2
    # 说明：这是所有历史点云数据的累积，形成完整的地图
    # 注意：地图数据量很大，会消耗大量内存和带宽，仅在必要时启用
    - Alpha: 1                                # 点云不透明度
      Autocompute Intensity Bounds: true      # 自动计算强度值范围
      
      # 颜色映射的数值范围（初始值异常，会自动调整）
      Autocompute Value Bounds:
        Max Value: -9999                      # 初始最大值（会被自动更新）
        Min Value: 9999                       # 初始最小值（会被自动更新）
        Value: true                           # 启用自动范围计算
        
      Axis: Z                               # 颜色映射轴（Z轴=高度）
      Channel Name: intensity               # 颜色通道名称
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255                  # 默认颜色（白色）
      Color Transformer: AxisColor          # 颜色变换器（按轴着色）
      Decay Time: 0                         # 点云立即消失（每次都重新显示完整地图）
      Enabled: true                         # 启用点云显示
      Invert Rainbow: false                 # 不反转彩虹色谱
      Max Color: 255; 255; 255              # 最大值颜色（白色）
      Max Intensity: 255                    # 最大强度值
      Min Color: 0; 0; 0                    # 最小值颜色（黑色）
      Min Intensity: 0                      # 最小强度值
      Name: CloudMap                        # 显示组件名称
      Position Transformer: XYZ             # 位置变换器
      Selectable: true                      # 点云可选择
      Size (Pixels): 3                      # 点的像素大小
      Size (m): 0.05000000074505806         # 点的物理大小（米）
      Style: Flat Squares                   # 点的显示样式（平面方块）
      
      # ROS2话题订阅设置
      Topic:
        Depth: 5                    # 消息队列深度
        Durability Policy: Volatile # 消息持久性策略
        Filter size: 10             # 滤波器大小
        History Policy: Keep Last   # 历史消息保持策略
        Reliability Policy: Reliable # 可靠性策略
        Value: /Laser_map           # 订阅的话题名称（对应publish_map函数的输出）
        
      Use Fixed Frame: true         # 使用固定坐标系
      Use rainbow: true             # 使用彩虹色谱（按高度着色）
      Value: true                   # 启用此显示组件
  Enabled: true                    # 启用可视化管理器
  
  # === 全局选项 ===
  # 设置整个RViz界面的基本参数
  Global Options:
    Background Color: 0; 0; 0       # 背景颜色（黑色）
    Fixed Frame: camera_init        # 固定坐标系（世界坐标系）
                                    # 注意：这必须与LaserMappingNode发布的坐标系名称一致
    Frame Rate: 30                  # 界面刷新帧率（Hz）
    
  Name: root                        # 根节点名称
  
  # === 交互工具栏 ===
  # 定义RViz界面顶部工具栏的各种交互工具
  Tools:
    # 交互工具 - 基本的3D场景交互
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true   # 隐藏非激活对象
      
    # 相机移动工具 - 改变观察视角
    - Class: rviz_default_plugins/MoveCamera
    
    # 选择工具 - 选择3D场景中的对象
    - Class: rviz_default_plugins/Select
    
    # 聚焦相机工具 - 将相机聚焦到选中对象
    - Class: rviz_default_plugins/FocusCamera
    
    # 测量工具 - 测量3D场景中的距离
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0       # 测量线颜色（橄榄绿）
      
    # 设置初始姿态工具 - 为机器人设置初始位置（通常用于定位）
    # ROS2连接：发布到 /initialpose 话题
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25            # X方向协方差
      Covariance y: 0.25            # Y方向协方差
      Covariance yaw: 0.06853891909122467  # 偏航角协方差
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose         # 发布话题名称
        
    # 设置目标点工具 - 为机器人设置导航目标
    # ROS2连接：发布到 /goal_pose 话题
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose           # 发布话题名称
        
    # 发布点工具 - 在3D场景中点击发布点坐标
    # ROS2连接：发布到 /clicked_point 话题
    - Class: rviz_default_plugins/PublishPoint
      Single click: true            # 单击发布
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point       # 发布话题名称
  # === 坐标变换系统 ===
  # 管理RViz中的坐标变换显示
  Transformation:
    Current:
      Class: rviz_default_plugins/TF  # 使用TF2坐标变换系统
      
  Value: true                       # 启用可视化管理器
  
  # === 视图配置 ===
  # 控制3D场景的观察视角和相机参数
  Views:
    Current:
      Class: rviz_default_plugins/Orbit    # 轨道相机模式（围绕焦点旋转）
      Distance: 216.99887084960938          # 相机到焦点的距离（米）
      
      # 立体渲染设置（用于VR/AR，通常不启用）
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549  # 双眼间距
        Stereo Focal Distance: 1                    # 立体聚焦距离
        Swap Stereo Eyes: false                     # 不交换左右眼
        Value: false                                # 不启用立体渲染
        
      # 相机焦点位置（相机围绕此点旋转）
      Focal Point:
        X: -0.008504047989845276        # 焦点X坐标（米）
        Y: -0.0005770106799900532       # 焦点Y坐标（米）
        Z: 0.034441977739334106         # 焦点Z坐标（米）
        
      Focal Shape Fixed Size: true      # 焦点标记固定大小
      Focal Shape Size: 0.05000000074505806  # 焦点标记大小
      Invert Z Axis: false              # 不反转Z轴
      Name: Current View                # 当前视图名称
      Near Clip Distance: 0.009999999776482582  # 近裁剪面距离
      Pitch: 1.5697963237762451         # 俯仰角（弧度）
      Target Frame: <Fixed Frame>       # 目标坐标系（使用固定坐标系）
      Value: Orbit (rviz_default_plugins)  # 视图类型
      Yaw: 4.88355827331543             # 偏航角（弧度）
      
    Saved: ~                            # 保存的视图（无）
# === RViz窗口布局配置 ===
# 定义RViz界面的窗口大小、位置和面板布局
# 这些设置在RViz启动时会自动应用
Window Geometry:
  # 各个面板的显示状态
  Displays:
    collapsed: false            # 显示面板不折叠
    
  Height: 846                   # 窗口高度（像素）
  Hide Left Dock: false         # 不隐藏左侧停靠面板
  Hide Right Dock: false        # 不隐藏右侧停靠面板
  
  # Qt主窗口状态（二进制编码的布局信息）
  # 这个长字符串包含了详细的面板大小、位置信息
  QMainWindow State: 
  
  # 各个面板的折叠状态
  Selection:
    collapsed: false            # 选择面板不折叠
  Time:
    collapsed: false            # 时间面板不折叠
  Tool Properties:
    collapsed: false            # 工具属性面板不折叠
  Views:
    collapsed: false            # 视图面板不折叠
    
  Width: 1453                   # 窗口宽度（像素）
  X: 368                        # 窗口X位置（像素）
  Y: 104                        # 窗口Y位置（像素）

# ========================================
# RViz与ROS2系统的连接关系总结：
# ========================================
#
# 1. 坐标变换 (TF):
#    - 自动订阅: /tf, /tf_static
#    - 数据来源: LaserMappingNode::publish_odometry()中的tf_broadcaster_
#    - 显示: camera_init -> body 的坐标变换关系
#
# 2. 里程计 (Odometry):
#    - 订阅话题: /Odometry
#    - 数据来源: LaserMappingNode::publish_odometry()
#    - 消息类型: nav_msgs::msg::Odometry
#    - 显示: 机器人位置、姿态和不确定性
#
# 3. 路径轨迹 (Path):
#    - 订阅话题: /path
#    - 数据来源: LaserMappingNode::publish_path()
#    - 消息类型: nav_msgs::msg::Path
#    - 显示: 机器人历史运动轨迹
#
# 4. 配准点云 (CloudRegistered):
#    - 订阅话题: /cloud_registered
#    - 数据来源: LaserMappingNode::publish_frame_world()
#    - 消息类型: sensor_msgs::msg::PointCloud2
#    - 显示: 当前帧经过SLAM处理的点云数据
#
# 5. 有效点云 (CloudEffected):
#    - 订阅话题: /cloud_effected
#    - 数据来源: LaserMappingNode::publish_effect_world()
#    - 消息类型: sensor_msgs::msg::PointCloud2
#    - 显示: 参与SLAM计算的有效特征点
#
# 6. 地图点云 (CloudMap):
#    - 订阅话题: /Laser_map
#    - 数据来源: LaserMappingNode::publish_map()
#    - 消息类型: sensor_msgs::msg::PointCloud2
#    - 显示: 累积的全局地图
#
# 7. 交互工具:
#    - 发布话题: /initialpose, /goal_pose, /clicked_point
#    - 用途: 用户与系统交互，设置初始位置、目标点等
#
# 使用说明：
# - 启动FAST-LIO2系统后，运行: rviz2 -d /path/to/this/file
# - 或在RViz中通过 File -> Open Config 加载此配置
# - 各个显示组件可以在左侧Displays面板中单独启用/禁用
# - 建议根据计算机性能选择性启用点云显示（特别是CloudMap）
# ========================================
